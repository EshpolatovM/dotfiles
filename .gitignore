# ==============================================================================
# Dotfiles Repository Gitignore (Security & Cleanliness)
# ==============================================================================

# Private Keys & Certificates
id_*
*.key
*.pem
*.pfx
*.p12
*.pkcs12
*.crt
secring.*
!id_*.pub

# Environment Variables & Secrets
.env
.env.*
*.env
*token*
*secret*
*credential*
credentials.json
auth.json

# Shell & Command History
.*_history
.zsh_history
.bash_history
.python_history
.node_repl_history
.lesshst

# Editor & Temporary files
*.swp
*.swo
*~
*.bak
*.save
*.tmp
*.orig

# IDE & Editor configurations
.idea/
.vscode/
*.iml

# System & OS junk
.DS_Store
Thumbs.db
desktop.ini

# Backup files
*.bak
*.bak.*
